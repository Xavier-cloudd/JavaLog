import java.util.Scanner;
 
public class PayrollComputation {
 
    static final int WEEKS = 4;
    static final double REGULAR_LIMIT = 40;          // regular hours per week
    static final double OT_MULTIPLIER = 1.25;        // overtime rate multiplier
    static final double MANAGER_ALLOWANCE = 5000 * 4; // P5,000 x 4
 
    static Scanner sc = new Scanner(System.in);
 
    // ===================== MAIN PROGRAM (Flowchart 1) =====================
    public static void main(String[] args) {
        System.out.println("==========================================");
        System.out.println("        PAYROLL COMPUTATION SYSTEM        ");
        System.out.println("==========================================");
 
        String again;
        do {
            // ---- INPUT ----
            System.out.println();
            String lastName   = readText("Last Name   : ");
            String firstName  = readText("First Name  : ");
            String middleName = readText("Middle Name : ");
            String department = readText("Department  : ");
            String position   = readText("Position    : ");
            double rate       = readDouble("Rate per hour: ", 0);
 
            double[] weeklyHours = new double[WEEKS];
            for (int i = 0; i < WEEKS; i++) {
                weeklyHours[i] = readDouble("Hours worked, Week " + (i + 1) + ": ", 0);
            }
 
            int dependents = (int) readDouble("Number of dependents: ", 0);
 
            // ---- PROCESS ----
            boolean manager = position.toLowerCase().contains("manager");
 
            double totalHours    = computeTotalHours(weeklyHours);
            double regularHours  = computeRegularHours(weeklyHours);
            double overtimeHours = computeOvertimeHours(weeklyHours);
 
            double overtimePay = computeOvertimePay(overtimeHours, rate);
            double allowance   = computeAllowance(manager);
 
            double grossPay       = computeGP(rate, regularHours, overtimePay, allowance);
            double totalDeduction = computeDed(grossPay, totalHours, dependents);
            double netPay         = computeNP(grossPay, totalDeduction);
 
            // ---- OUTPUT ----
            displayPaySlip(lastName, firstName, middleName, department, position, rate,
                    weeklyHours, totalHours, regularHours, overtimeHours,
                    overtimePay, allowance, grossPay, dependents, totalDeduction, netPay);
 
            again = readText("\nRun again? (Y/N): ");
        } while (again.equalsIgnoreCase("Y"));
 
        System.out.println("\nThank you for using the Payroll Computation System. Goodbye!");
    }
 
    // ===================== HOURS FUNCTIONS (Flowchart 2) =====================
    static double computeTotalHours(double[] weeklyHours) {
        double total = 0;
        for (int i = 0; i < WEEKS; i++) {
            total += weeklyHours[i];
        }
        return total;
    }
 
    static double computeRegularHours(double[] weeklyHours) {
        double regular = 0;
        for (int i = 0; i < WEEKS; i++) {
            if (weeklyHours[i] > REGULAR_LIMIT) {
                regular += REGULAR_LIMIT;
            } else {
                regular += weeklyHours[i];
            }
        }
        return regular;
    }
 
    static double computeOvertimeHours(double[] weeklyHours) {
        double overtime = 0;
        for (int i = 0; i < WEEKS; i++) {
            if (weeklyHours[i] > REGULAR_LIMIT) {
                overtime += weeklyHours[i] - REGULAR_LIMIT;
            }
        }
        return overtime;
    }
 
    // ===================== PAY FUNCTIONS =====================
    static double computeOvertimePay(double overtimeHours, double rate) {
        return overtimeHours * (rate * OT_MULTIPLIER);
    }
 
    static double computeAllowance(boolean manager) {
        return manager ? MANAGER_ALLOWANCE : 0;
    }
 
    // Flowchart 3
    static double computeGP(double rate, double regularHours, double overtimePay, double allowance) {
        return rate * regularHours + overtimePay + allowance;
    }
 
    static double computeNP(double grossPay, double totalDeduction) {
        return grossPay - totalDeduction;
    }
 
    // ===================== DEDUCTIONS (Flowcharts 4, 5, 6) =====================
    static double computeDed(double grossPay, double totalHours, int dependents) {
        double sss        = computeSSS(grossPay);
        double pagibig    = computePagibig(grossPay);
        double philhealth = computePhilhealth(totalHours);
        double tax        = computeTax(grossPay);
        double depDed     = computeDependentDeduction(dependents);
        return sss + pagibig + philhealth + tax + depDed;
    }
 
    static double computeSSS(double gp) {
        double sss;
        if (gp <= 5000) {
            sss = 105.00;
        } else if (gp <= 10000) {
            sss = gp * 0.05;
        } else if (gp <= 15000) {
            sss = gp * 0.08 + 75;
        } else {
            sss = gp * 0.12 + 110;
        }
        return sss;
    }
 
    static double computeTax(double gp) {
        double tax;
        if (gp <= 10000) {
            tax = gp * 0.03;
        } else if (gp <= 25000) {
            tax = gp * 0.08;
        } else if (gp <= 40000) {
            tax = gp * 0.11;
        } else {
            tax = gp * 0.135;
        }
        return tax;
    }
 
    static double computePagibig(double gp) {
        if (gp < 5000) {
            return 100.00;
        }
        return gp * 0.03;
    }
 
    static double computePhilhealth(double totalHours) {
        if (totalHours < 10) {
            return 0;
        }
        return 120.00;
    }
 
    static double computeDependentDeduction(int dependents) {
        return dependents * 1000;
    }
 
    // ===================== OUTPUT =====================
    static void displayPaySlip(String last, String first, String middle, String dept,
                               String position, double rate, double[] weeklyHours,
                               double totalHours, double regularHours, double overtimeHours,
                               double overtimePay, double allowance, double grossPay,
                               int dependents, double totalDeduction, double netPay) {
 
        String line = "==========================================";
        System.out.println("\n" + line);
        System.out.println("                PAY SLIP                  ");
        System.out.println(line);
 
        System.out.println("EMPLOYEE INFORMATION");
        System.out.printf("  Name        : %s, %s %s%n", last, first, middle);
        System.out.printf("  Department  : %s%n", dept);
        System.out.printf("  Position    : %s%n", position);
        System.out.printf("  Rate / hour : P%,.2f%n", rate);
        System.out.printf("  Dependents  : %d%n", dependents);
 
        System.out.println("\nHOURS WORKED");
        for (int i = 0; i < WEEKS; i++) {
            System.out.printf("  Week %d      : %.2f%n", i + 1, weeklyHours[i]);
        }
        System.out.printf("  Total Hours : %.2f%n", totalHours);
        System.out.printf("  Regular Hrs : %.2f%n", regularHours);
        System.out.printf("  Overtime Hrs: %.2f%n", overtimeHours);
 
        System.out.println("\nSALARY COMPUTATION");
        System.out.printf("  Regular Pay : P%,.2f%n", rate * regularHours);
        System.out.printf("  Overtime Pay: P%,.2f%n", overtimePay);
        System.out.printf("  Allowance   : P%,.2f%n", allowance);
        System.out.printf("  GROSS PAY   : P%,.2f%n", grossPay);
 
        System.out.println("\nDEDUCTIONS");
        System.out.printf("  SSS         : P%,.2f%n", computeSSS(grossPay));
        System.out.printf("  Pag-IBIG    : P%,.2f%n", computePagibig(grossPay));
        System.out.printf("  PhilHealth  : P%,.2f%n", computePhilhealth(totalHours));
        System.out.printf("  Tax         : P%,.2f%n", computeTax(grossPay));
        System.out.printf("  Dependents  : P%,.2f%n", computeDependentDeduction(dependents));
        System.out.printf("  TOTAL DED.  : P%,.2f%n", totalDeduction);
 
        System.out.println("\n" + line);
        System.out.printf("  NET PAY     : P%,.2f%n", netPay);
        System.out.println(line);
    }
 
    // ===================== INPUT HELPERS =====================
    static String readText(String prompt) {
        System.out.print(prompt);
        return sc.nextLine().trim();
    }
 
    static double readDouble(String prompt, double min) {
        while (true) {
            System.out.print(prompt);
            try {
                double value = Double.parseDouble(sc.nextLine().trim());
                if (value >= min) {
                    return value;
                }
                System.out.println("  Value must be at least " + min + ". Try again.");
            } catch (NumberFormatException e) {
                System.out.println("  Invalid number. Try again.");
            }
        }
    }
}
 

